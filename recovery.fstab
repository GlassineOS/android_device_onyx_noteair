# Draft for the GlassineOS layout. system_b is deliberately absent:
# glassine-deploy owns its mounts (a hibernated session must be resumed or
# invalidated before any read-write mount), so TWRP never mounts it on its own
# and offers no wipe for it.
#
# mount point   fstype  device                               flags
/boot           emmc    /dev/block/by-name/boot_b            flags=display="Boot (GlassineOS)"
/recovery       emmc    /dev/block/by-name/recovery          flags=display="Recovery"
/data           ext4    /dev/block/by-name/userdata          flags=display="Data"
